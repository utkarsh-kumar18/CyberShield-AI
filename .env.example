# Copy to .env and replace every CHANGE_ME value before starting Docker Compose.
CYBERSHIELD_SECRET_KEY=CHANGE_ME_generate_a_long_random_secret
CYBERSHIELD_ADMIN_API_KEY=CHANGE_ME_generate_a_different_long_random_secret
POSTGRES_DB=cybershield
POSTGRES_USER=cybershield
POSTGRES_PASSWORD=CHANGE_ME_url_safe_database_password
REDIS_PASSWORD=CHANGE_ME_url_safe_redis_password
GOOGLE_SAFE_BROWSING_API_KEY=
VIRUSTOTAL_API_KEY=
API_PORT=5000
WAITRESS_THREADS=8
